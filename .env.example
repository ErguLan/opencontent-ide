# ============================================
# OpenContent IDE — Environment Configuration
# ============================================
# Copy this file to .env and add your keys.
# All keys are optional. The app works without any.

# ── AI Providers (add at least one model in Settings) ─

# OpenRouter API — access to 200+ models via one key
# Get your free key at: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=

# OpenAI API — GPT-4o, GPT-4o-mini, DALL-E
# Get your key at: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=

# Google Gemini API — text + image generation
# Get your free key at: https://aistudio.google.com/apikey
VITE_GOOGLE_API_KEY=

# Anthropic API — Claude models
# Get your key at: https://console.anthropic.com/settings/keys
VITE_ANTHROPIC_API_KEY=

# ── Local Models (Ollama) ────────────────────

# Point to your local Ollama instance for 100% offline usage
# Install Ollama: https://ollama.com
VITE_OLLAMA_BASE_URL=http://localhost:11434

# ── App Configuration ────────────────────────

VITE_APP_NAME=OpenContent IDE
VITE_APP_VERSION=0.1.0

# Enable usage limits (for self-hosted SaaS forks)
# Set to "true" to activate freemium limits
VITE_ENABLE_USAGE_LIMITS=false

# CLI access level: 'public' | 'local_only' | 'disabled'
# Default is 'public' (accessible from any host)
VITE_CLI_ACCESS=public

# Disable the CLI entirely
VITE_CLI_ENABLED=true

# Request timeout in milliseconds (default: 45000)
VITE_AI_REQUEST_TIMEOUT_MS=45000

# ── Standalone CLI / MCP filesystem gallery ─────────
# These variables are read by Node processes, not by Vite.
# The gallery directory is read-only by default; cloning requires explicit write access.
OC_GALLERY_DIR=./gallery
OC_OUTPUT_DIR=./opencontent-artifacts
OC_ALLOWED_CLONE_DIRS=
OC_ALLOW_LOCAL_WRITES=false
OC_ALLOW_OVERWRITE=false
