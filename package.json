{
  "name": "opencontent-ide",
  "private": false,
  "version": "0.1.0",
  "description": "Open source AI content creation IDE. Self-hosted, BYOK, Ollama-compatible.",
  "type": "module",
  "bin": {
    "opencontent": "./cli/index.js",
    "oc": "./cli/index.js"
  },
  "keywords": ["ai", "content-creation", "open-source", "self-hosted", "byok", "ollama"],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:install": "cd server && npm install",
    "server:start": "cd server && node index.js",
    "mcp:start": "node mcp/index.js",
    "mcp:artifacts": "node mcp/artifacts.js",
    "cli": "node cli/index.js",
    "cli:artifacts": "node cli/artifacts.js",
    "rust:check": "cd rust/oc-core && cargo check",
    "rust:test": "cd rust/oc-core && cargo test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "vite": "^7.2.4",
    "vitest": "^4.1.9"
  }
}
